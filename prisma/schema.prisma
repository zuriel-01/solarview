generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SystemConfig {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  batteryCapacity   Int      @map("battery_capacity")
  panelSize         Float    @map("panel_size")
  minSoc            Float    @map("min_soc")
  installationYear Int      @default(2025) @map("installation_year")
  panelRating       Int      @default(400) @map("panel_rating")
  numberOfPanels    Int      @default(10) @map("number_of_panels")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model Room {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  appliances Appliance[]

  @@unique([userId, name])
  @@index([userId])
  @@map("rooms")
}

model Appliance {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  name       String
  wattage    Int
  usageHours Float    @map("usage_hours")
  createdAt  DateTime @default(now()) @map("created_at")
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("appliances")
}